# ClimatePulse Environment Configuration
# Copy to .env and fill in your values

# === API Keys (Free registration required) ===
DATA_OPENAQ_API_KEY=your_openaq_api_key_here

# === Model Training ===
MODEL_CHECKPOINT_DIR=./models/checkpoints
MODEL_DEVICE=auto
MODEL_MAX_EPOCHS=100
MODEL_BATCH_SIZE=32
MODEL_LEARNING_RATE=0.001
MODEL_LOG_FREQUENCY=1
MODEL_TFT_ENCODER_LENGTH=120
MODEL_LSTM_ENCODER_LENGTH=60
MODEL_TFT_PREDICTION_MONTHS=12
MODEL_LSTM_PREDICTION_MONTHS=36

# === Logging ===
LOG_LEVEL=INFO
LOG_DIR=./logs
